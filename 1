}

const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
let trailStep = 0;

function drawPixelCowboy(x, y, color = '#8c5d3b', scale = 1) {
    ctx.save();
    ctx.translate(x, y);

    ctx.fillStyle = color;
    ctx.fillRect(-10 * scale, -8 * scale, 20 * scale, 4 * scale);
    ctx.fillRect(-5 * scale, -14 * scale, 10 * scale, 6 * scale);
    ctx.fillStyle = '#e8c39e';
    ctx.fillRect(-4 * scale, -4 * scale, 8 * scale, 5 * scale);
    ctx.fillStyle = '#2b1d0f';
    ctx.fillRect(-5 * scale, 1 * scale, 10 * scale, 8 * scale);
    ctx.fillStyle = '#614124';
    ctx.fillRect(-8 * scale, 6 * scale, 16 * scale, 8 * scale);

    ctx.restore();
}

function drawScene() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    if (gameState.mode === 'MARCH' || gameState.mode === 'OUTFIT') {
        ctx.fillStyle = '#d4a86a';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#b88b4a';
        ctx.fillRect(0, 160, canvas.width, 100);

        ctx.fillStyle = '#7a8a40';
        for (let i = 0; i < canvas.width; i += 80) {
            ctx.fillRect((i + trailStep * 2) % canvas.width, 50, 6, 12);
            ctx.fillRect((i + 30 + trailStep * 2) % canvas.width, 320, 8, 10);
        }

        ctx.fillStyle = '#6e3c1b';
        for (let i = 0; i < 30; i++) {
            let x = (220 + (i * 18) + (Math.sin(i + trailStep * 0.1) * 8)) % (canvas.width - 260);
            let y = 170 + (i % 5) * 16;
            ctx.fillRect(x + 120, y, 14, 10);
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(x + 120 - 2, y - 2, 4, 2);
            ctx.fillRect(x + 120 + 12, y - 2, 4, 2);
            ctx.fillStyle = '#6e3c1b';
        }

        const totalCrew = gameState.crew;
        if (totalCrew > 0) {
            let pointCount = Math.min(2, totalCrew);
            for (let i = 0; i < pointCount; i++) {
                drawPixelCowboy(680 + (i * 25), 180 + (i * 30), '#5c8043');
            }

            let remainingAfterPoint = totalCrew - pointCount;
            let swingCount = Math.min(6, remainingAfterPoint);
            for (let i = 0; i < swingCount; i++) {
                let sideY = (i % 2 === 0) ? 130 : 270;
                let posX = 300 + (Math.floor(i / 2) * 80);
                drawPixelCowboy(posX, sideY, '#8c5d3b');
            }

            let dragCount = remainingAfterPoint - swingCount;
            for (let i = 0; i < dragCount; i++) {
                drawPixelCowboy(220 - (i * 20), 180 + ((i % 3) * 20), '#2b5d88');
            }
        }

        trailStep++;
    } else if (gameState.mode === 'MINIGAME') {
        updateAndRenderMinigame();
    }

    animationFrameId = requestAnimationFrame(drawScene);
}

