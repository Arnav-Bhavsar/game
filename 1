function restHerd() {
    gameState.day++;

    const foodConsumed = gameState.crew * 3;
    gameState.food -= foodConsumed;

    if (gameState.food <= 0) {
        gameState.food = 0;
        gameState.daysWithoutFood++;
        gameState.avgWeight -= 15;

        if (gameState.daysWithoutFood >= 3) {
            triggerStarvationDeath();
            return;
        } else {
            showNotice("STARVATION WARNING", `No food available while resting! Starvation day ${gameState.daysWithoutFood}/3.`);
            updateHUD();
            return;
        }
    } else {
        gameState.daysWithoutFood = 0;
    }

    const roll = Math.random();

    if (roll < 0.40) {
        const gain = Math.floor(Math.random() * 9) + 10;
        gameState.avgWeight += gain;
        sound.playSuccess();
        logEvent(`🌾 <strong style="color: #7a8a40;">GREAT GRAZE!</strong> Found lush prairie clover! Steers gained <strong>+${gain} lbs</strong>.`);
    } 
    else if (roll < 0.75) {
        const gain = Math.floor(Math.random() * 5) + 4;
        gameState.avgWeight += gain;
        logEvent(`🌿 <strong>QUIET PASTURE:</strong> Decent grazing ground. Steers gained <strong>+${gain} lbs</strong>.`);
    } 
    else if (roll < 0.90) {
        const lostCattle = Math.floor(Math.random() * 8) + 5;
        gameState.avgWeight = Math.max(500, gameState.avgWeight - 10);
        gameState.cattle = Math.max(1, gameState.cattle - lostCattle);
        sound.playError();
        logEvent(`⚠️ <strong style="color: #d93838;">BAD WATER & LOCOWEED:</strong> Cattle fell ill! Steers lost <strong>-10 lbs</strong> and <strong>${lostCattle} died</strong>.`);
    } 
    else {
        const baseLoss = Math.floor(Math.random() * 15) + 10;
        const savedByCrew = Math.min(baseLoss - 2, Math.floor(gameState.crew * 0.8));
        const finalLoss = Math.max(2, baseLoss - savedByCrew);
        gameState.cattle = Math.max(1, gameState.cattle - finalLoss);
        sound.playError();
        logEvent(`🐺 <strong style="color: #d93838;">NIGHT RAID:</strong> Wolves/rustlers struck! Lost <strong>${finalLoss} cattle</strong> (Crew defended ${savedByCrew}).`);
    }

    updateHUD();
}

function advanceDay() {
    gameState.day++;

    const foodConsumed = gameState.crew * 3;
    gameState.food -= foodConsumed;

    if (gameState.food <= 0) {
        gameState.food = 0;
        gameState.daysWithoutFood++;
        gameState.avgWeight -= 15;

        if (gameState.daysWithoutFood >= 3) {
            triggerStarvationDeath();
            return;
        } else {
            showNotice(
                "CRITICAL STARVATION WARNING", 
                `Out of food for <strong>${gameState.daysWithoutFood} day(s)</strong>!<br><br>Cowboys are severely malnourished. If you go <strong>${3 - gameState.daysWithoutFood} more day(s)</strong> without food, your crew will collapse!`
            );
        }
    } else {
        gameState.daysWithoutFood = 0;
    }

    let distGained = gameState.pace;
    let baseWeightLoss = (gameState.pace === 18) ? 8 : (gameState.pace === 8 ? 2 : 4);

    const roll = Math.random();

    if (roll < 0.45) {
        gameState.distanceTraveled += distGained;
        gameState.avgWeight -= baseWeightLoss;
        logEvent(`🐎 <strong>SMOOTH MARCH:</strong> Covered <strong>${distGained} miles</strong> cleanly (-${baseWeightLoss} lbs fatigue).`);
    } 
    else if (roll < 0.75) {
        const extraLoss = baseWeightLoss * 2;
        gameState.distanceTraveled += distGained;
        gameState.avgWeight -= extraLoss;
        logEvent(`☀️ <strong style="color: #b87b4e;">HARSH HEATWAVE:</strong> Deep mud and heat strained steers (-${extraLoss} lbs fatigue).`);
    } 
    else if (roll < 0.90) {
        const bonusDist = distGained + 5;
        gameState.distanceTraveled += bonusDist;
        gameState.avgWeight -= baseWeightLoss;
        sound.playSuccess();
        logEvent(`🧭 <strong style="color: #7a8a40;">SHORTCUT FOUND:</strong> Native scout guided a quick path! Covered <strong>${bonusDist} miles</strong>.`);
    } 
    else {
        gameState.distanceTraveled += distGained;
        gameState.avgWeight -= baseWeightLoss;
        logEvent(`⚠️ <strong style="color: #d93838;">HAZARD ENCOUNTERED:</strong> Panic broke out on the trail!`);
        promptMinigame(Math.random() < 0.5 ? 'STAMPEDE' : 'NIGHTWATCH');
        updateHUD();
        return;
    }

    if (gameState.distanceTraveled >= 200 && gameState.distanceTraveled < 350) gameState.location = 'Red River';
    else if (gameState.distanceTraveled >= 350 && gameState.distanceTraveled < 550) gameState.location = 'Indian Territory';
    else if (gameState.distanceTraveled >= 550) gameState.location = 'Kansas Border';

    if (gameState.distanceTraveled >= 200 && !gameState.riverTriggered) {
        gameState.riverTriggered = true;
        promptMinigame('RIVER');
        return;
    }

    if (gameState.distanceTraveled >= gameState.totalDistance) {
        triggerEndGame();
        return;
    }

    updateHUD();
}

