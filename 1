        </div>
        <div style="margin-top: 12px;">
            <button class="btn" onclick="startMinigame('${type}')">Play Mini-Game</button>
        </div>
    `;
}

function startMinigame(type) {
    closeModal();
    gameState.mode = 'MINIGAME';
    gameState.minigameTimer = 0;
    document.getElementById('minigame-hud').classList.remove('hidden');

    if (type === 'STAMPEDE') {
        gameState.minigameTimer = 30;
        mgState = {
            playerX: 60, playerY: 210, 
            speed: 3.5,
            targetCircle: { x: 480, y: 210, r: 120 },
            holdProgress: 0,
            lastTickTime: Date.now(),
            cattle: Array.from({length: 16}, () => ({
                x: 480 + (Math.random()*200 - 100),
                y: 210 + (Math.random()*140 - 70),
                vx: 0,
                vy: 0,
                panicked: false,
                panicTimer: 0
            }))
        };
    } else if (type === 'NIGHTWATCH') {
        mgState = {
            completion: 0,
            lanes: [120, 180, 240, 300],
            pitches: [440, 523, 587, 659],
            notes: [
                { x: 500, y: 120, pitch: 440 },
                { x: 650, y: 240, pitch: 587 }, 
                { x: 800, y: 180, pitch: 523 }, 
                { x: 950, y: 300, pitch: 659 }
            ],
            targetX: 180,
            spawnTimer: 0
        };
    } else if (type === 'RIVER') {
        gameState.minigameTimer = 25;
        mgState = { 
            playerX: 480, playerY: 380, speed: 4.0, 
            quicksand: [
                { x: 150, y: 290, r: 42, vx: 2.2 },
                { x: 480, y: 290, r: 45, vx: -2.8 },
                { x: 800, y: 290, r: 42, vx: 2.0 },
                { x: 280, y: 190, r: 46, vx: -3.2 },
                { x: 650, y: 190, r: 44, vx: 2.6 },
                { x: 180, y: 100, r: 40, vx: 2.5 },
                { x: 500, y: 100, r: 48, vx: -2.9 },
                { x: 820, y: 100, r: 42, vx: 2.3 }
            ], 
            trapped: false, mashProgress: 0 
        };
    }

    if (minigameIntervalId) clearInterval(minigameIntervalId);
    minigameIntervalId = setInterval(() => {
        if (type !== 'NIGHTWATCH') {
            gameState.minigameTimer--;
            if (gameState.minigameTimer <= 0) {
                if (type === 'STAMPEDE') endMinigame(mgState.holdProgress >= 100);
                else if (type === 'RIVER') endMinigame(mgState.playerY <= 50);
            }
        } else {
            gameState.minigameTimer++;
        }
    }, 1000);
}

function handleNightwatchPress() {
    if (gameState.activeMinigame !== 'NIGHTWATCH') return;
    
    let hit = false;
    for (let i = 0; i < mgState.notes.length; i++) {
        let note = mgState.notes[i];
        if (Math.abs(note.x - mgState.targetX) < 35) {
            hit = true;
            sound.playTone(note.pitch, 0.2, 'sine');
            mgState.completion = Math.min(100, mgState.completion + 7.0);
            mgState.notes.splice(i, 1);

            if (mgState.completion >= 100) {
                endMinigame(true);
            }
            break;
        }
    }
    if (!hit) {
        sound.playError();
        mgState.completion = Math.max(0, mgState.completion - 3);
        
        let laneIdx = Math.floor(Math.random() * mgState.lanes.length);
        mgState.notes.push({
            x: canvas.width + 120,
            y: mgState.lanes[laneIdx],
            pitch: mgState.pitches[laneIdx]
        });
    }
}

function endMinigame(success) {
    if (minigameIntervalId) clearInterval(minigameIntervalId);
    document.getElementById('minigame-hud').classList.add('hidden');
    const mgType = gameState.activeMinigame;
    gameState.mode = 'MARCH';

    if (success) {
        sound.playSuccess();
        if (!minigameFirstWins[mgType]) {
            minigameFirstWins[mgType] = true;
            showNotice("HAZARD CLEARED!", HISTORICAL_EXPLANATIONS[mgType].winFirst);
        } else {
            showNotice("HAZARD CLEARED", "Success! You expertly handled the trail hazard.");
        }
    } else {
        sound.playError();
        gameState.avgWeight -= 20;
        showNotice("HAZARD FAILED", HISTORICAL_EXPLANATIONS[mgType].failure);
    }
    updateHUD();
}

function updateAndRenderMinigame() {
    document.getElementById('mg-timer').innerText = `TIME: ${gameState.minigameTimer}s`;

    if (gameState.activeMinigame === 'STAMPEDE') {
        document.getElementById('mg-status').innerText = `HOLD METER: ${Math.round(mgState.holdProgress)}%`;

        if (keysPressed['arrowleft'] || keysPressed['a']) mgState.playerX -= mgState.speed;
        if (keysPressed['arrowright'] || keysPressed['d']) mgState.playerX += mgState.speed;
        if (keysPressed['arrowup'] || keysPressed['w']) mgState.playerY -= mgState.speed;
        if (keysPressed['arrowdown'] || keysPressed['s']) mgState.playerY += mgState.speed;

        mgState.playerX = Math.max(20, Math.min(canvas.width - 20, mgState.playerX));
        mgState.playerY = Math.max(20, Math.min(canvas.height - 20, mgState.playerY));

        ctx.fillStyle = '#24170d';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.strokeStyle = '#5c8043';
        ctx.lineWidth = 6;
        ctx.setLineDash([12, 8]);
        ctx.beginPath();
        ctx.arc(mgState.targetCircle.x, mgState.targetCircle.y, mgState.targetCircle.r, 0, Math.PI * 2);
        ctx.stroke();
        ctx.setLineDash([]);

        ctx.fillStyle = '#5c8043';
        ctx.font = '11px "Press Start 2P"';
        ctx.fillText("KEEP ALL (+/- 3) CATTLE HERE", mgState.targetCircle.x - 135, mgState.targetCircle.y - mgState.targetCircle.r - 12);

        let totalX = 0, totalY = 0;
        mgState.cattle.forEach(c => { totalX += c.x; totalY += c.y; });
        let herdCenterX = totalX / mgState.cattle.length;
        let herdCenterY = totalY / mgState.cattle.length;

        let insideCount = 0;

        mgState.cattle.forEach((c, idx) => {
            if (!c.panicked && Math.random() < 0.007) {
                c.panicked = true;
                c.panicTimer = 110 + Math.floor(Math.random() * 60);
            }

            if (c.panicked) {
                c.panicTimer--;
                if (c.panicTimer <= 0) c.panicked = false;

                c.vx += (Math.random() - 0.5) * 2.5;
                c.vy += (Math.random() - 0.5) * 2.5;

                mgState.cattle.forEach((other, oIdx) => {
                    if (idx !== oIdx && !other.panicked) {
                        let odx = c.x - other.x;
                        let ody = c.y - other.y;
                        if (Math.hypot(odx, ody) < 35 && Math.random() < 0.08) {
                            other.panicked = true;
                            other.panicTimer = 70;
                        }
                    }
                });
            } else {
                let dxCenter = herdCenterX - c.x;
                let dyCenter = herdCenterY - c.y;
                c.vx += dxCenter * 0.0025;
                c.vy += dyCenter * 0.0025;
            }

            mgState.cattle.forEach((other, oIdx) => {
                if (idx !== oIdx) {
                    let odx = c.x - other.x;
                    let ody = c.y - other.y;
                    let odist = Math.hypot(odx, ody);
                    if (odist < 22 && odist > 0) {
                        c.vx += (odx / odist) * 0.25;
                        c.vy += (ody / odist) * 0.25;
                    }
                }
            });

            let dxPlayer = c.x - mgState.playerX;
            let dyPlayer = c.y - mgState.playerY;
            let distPlayer = Math.hypot(dxPlayer, dyPlayer);

            if (distPlayer < 100) {
                let pushAngle = Math.atan2(dyPlayer, dxPlayer);
                let force = (100 - distPlayer) * 0.035; 
                c.vx += Math.cos(pushAngle) * force;
                c.vy += Math.sin(pushAngle) * force;
            }

            c.vx *= 0.88;
            c.vy *= 0.88;

            c.x += c.vx;
            c.y += c.vy;

            c.x = Math.max(90, Math.min(canvas.width - 90, c.x));
            c.y = Math.max(90, Math.min(canvas.height - 90, c.y));

            let distTarget = Math.hypot(c.x - mgState.targetCircle.x, c.y - mgState.targetCircle.y);
            if (distTarget <= mgState.targetCircle.r) {
                insideCount++;
            }

            if (c.panicked) {
                ctx.fillStyle = '#d93838';
            } else if (distTarget <= mgState.targetCircle.r) {
                ctx.fillStyle = '#7a8a40';
            } else {
                ctx.fillStyle = '#8c5d3b';
            }

            ctx.fillRect(c.x - 8, c.y - 6, 16, 12);
        });

        let currentTime = Date.now();
        if (currentTime - mgState.lastTickTime >= 500) {
            mgState.lastTickTime = currentTime;

            const requiredCount = mgState.cattle.length - 3;
            if (insideCount >= requiredCount) {
                mgState.holdProgress = Math.min(100, mgState.holdProgress + 6);
                sound.playTone(523, 0.05, 'sine');
            } else {
                mgState.holdProgress = Math.max(0, mgState.holdProgress - 8);
            }

            if (mgState.holdProgress >= 100) {
                endMinigame(true);
            }
        }

        drawPixelCowboy(mgState.playerX, mgState.playerY, '#f7eed8', 1.2);

    } else if (gameState.activeMinigame === 'NIGHTWATCH') {
        document.getElementById('mg-status').innerText = `COMPLETION: ${Math.round(mgState.completion)}%`;

        ctx.fillStyle = '#121824';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.strokeStyle = '#232f42';
        ctx.lineWidth = 2;
        mgState.lanes.forEach(laneY => {
            ctx.beginPath();
            ctx.moveTo(0, laneY);
            ctx.lineTo(canvas.width, laneY);
            ctx.stroke();
        });

        ctx.strokeStyle = '#f7eed8';
        ctx.lineWidth = 6;
        ctx.beginPath();
        ctx.moveTo(mgState.targetX, 40);
        ctx.lineTo(mgState.targetX, 380);
        ctx.stroke();

        ctx.fillStyle = '#e8d8b0';
        ctx.font = '14px "Press Start 2P"';
        ctx.fillText("TARGET LINE", mgState.targetX - 55, 30);

        mgState.spawnTimer++;
        if (mgState.spawnTimer > 40 && mgState.completion < 100) {
            mgState.spawnTimer = 0;
            let laneIdx = Math.floor(Math.random() * mgState.lanes.length);
            mgState.notes.push({
                x: canvas.width + 30,
                y: mgState.lanes[laneIdx],
                pitch: mgState.pitches[laneIdx]
            });
        }

        for (let i = mgState.notes.length - 1; i >= 0; i--) {
            let note = mgState.notes[i];
            note.x -= 3.8;

            ctx.fillStyle = '#b87b4e';
            ctx.fillRect(note.x - 18, note.y - 18, 36, 36);
            ctx.strokeStyle = '#2b1d0f';
            ctx.strokeRect(note.x - 18, note.y - 18, 36, 36);

            if (note.x < mgState.targetX - 50) {
                mgState.notes.splice(i, 1);
                mgState.completion = Math.max(0, mgState.completion - 3);
                let laneIdx = Math.floor(Math.random() * mgState.lanes.length);
                mgState.notes.push({
                    x: canvas.width + 80,
                    y: mgState.lanes[laneIdx],
                    pitch: mgState.pitches[laneIdx]
                });
            }
        }

    } else if (gameState.activeMinigame === 'RIVER') {
        let progressPct = Math.max(0, Math.round(((380 - mgState.playerY) / 330) * 100));
        document.getElementById('mg-status').innerText = `PROGRESS: ${progressPct}%`;

        ctx.fillStyle = '#2c5d88';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.fillStyle = '#7a8a40';
        ctx.fillRect(0, 0, canvas.width, 50);

        ctx.fillStyle = '#1a3a5c';
        mgState.quicksand.forEach(q => {
            q.x += q.vx;
            if (q.x - q.r <= 50 || q.x + q.r >= canvas.width - 50) {
                q.vx *= -1;
            }

            ctx.beginPath();
            ctx.arc(q.x, q.y, q.r, 0, Math.PI * 2);
            ctx.fill();
        });

        if (!mgState.trapped) {
            if (keysPressed['arrowleft'] || keysPressed['a']) mgState.playerX -= mgState.speed;
            if (keysPressed['arrowright'] || keysPressed['d']) mgState.playerX += mgState.speed;
            if (keysPressed['arrowup'] || keysPressed['w']) mgState.playerY -= mgState.speed;
            if (keysPressed['arrowdown'] || keysPressed['s']) mgState.playerY += mgState.speed;

            mgState.playerX = Math.max(20, Math.min(canvas.width - 20, mgState.playerX));
            mgState.playerY = Math.max(20, Math.min(canvas.height - 20, mgState.playerY));

            mgState.quicksand.forEach(q => {
                if (Math.hypot(mgState.playerX - q.x, mgState.playerY - q.y) < q.r) {
                    mgState.trapped = true;
                    mgState.mashProgress = 0;
                }
            });

            if (mgState.playerY <= 50) {
                endMinigame(true);
            }
        } else {
            ctx.fillStyle = '#ffffff';
            ctx.font = '14px "Press Start 2P"';
            ctx.fillText("TRAPPED IN QUICKSAND! MASH SPACEBAR!", 200, 340);

            ctx.fillStyle = '#2b1d0f';
            ctx.fillRect(330, 350, 300, 20);
            ctx.fillStyle = '#5c8043';
            ctx.fillRect(330, 350, mgState.mashProgress * 3, 20);

            if (mgState.mashProgress >= 100) {
                mgState.trapped = false;
                mgState.playerY -= 25;
            }
        }

        drawPixelCowboy(mgState.playerX, mgState.playerY, '#f7eed8', 1.0);
    }
}

function triggerEndGame() {
    gameState.mode = 'END';
    document.getElementById('ledger-screen').classList.remove('hidden');

    const totalWeight = gameState.cattle * gameState.avgWeight;
    const grossRevenue = Math.round(totalWeight * 0.04);

    document.getElementById('ledger-stats').innerHTML = `
        Head Delivered: ${gameState.cattle} steers<br>
        Average Steer Weight: ${Math.round(gameState.avgWeight)} lbs<br>
        Total Beef Weight: ${totalWeight.toLocaleString()} lbs<br>
        Market Railhead Price: $0.04 / lb
    `;
    document.getElementById('ledger-financials').innerText = `GROSS REVENUE: $${grossRevenue.toLocaleString()}`;
}

function startGame() {
    sound.init();
    gameState.mode = 'OUTFIT';
    document.getElementById('title-screen').classList.add('hidden');
    document.getElementById('outfit-screen').classList.remove('hidden');
    renderKnowledgeGrid();
}

drawScene();
</script>
