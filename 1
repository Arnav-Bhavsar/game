let mgState = {};

function promptMinigame(type) {
    gameState.activeMinigame = type;
    const modal = document.getElementById('modal-overlay');
    const card = document.getElementById('modal-card');
    modal.classList.remove('hidden');

    let title = "", desc = "", controls = "";
    if (type === 'STAMPEDE') {
        title = "HAZARD: MIDNIGHT STAMPEDE!";
        desc = "Cattle panic frequently! Your horse movement is slower—herd the steers quickly into the green target ring!";
        controls = "CONTROLS: ARROW KEYS or WASD to nudge cattle into the circle.";
    } else if (type === 'NIGHTWATCH') {
        title = "HAZARD: NERVOUS HERD NIGHT WATCH";
        desc = "Sing trail lullabies! Notes drift down musical tracks. Press SPACEBAR as notes cross the target line!";
        controls = "CONTROLS: Press SPACEBAR when any note aligns with the vertical target line.";
    } else if (type === 'RIVER') {
        title = "HAZARD: RED RIVER CROSSING";
        desc = "Beware! Camouflaged dark blue quicksand pools block the riverbed. Mash SPACEBAR rapidly if caught!";
        controls = "CONTROLS: ARROW KEYS / WASD to swim north. Mash SPACEBAR if trapped.";
    }

    card.innerHTML = `
        <h2 style="font-size: 16px; color: #8c5d3b;">${title}</h2>
        <p style="font-size: 18px;">${desc}</p>
