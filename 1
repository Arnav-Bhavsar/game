function finishOutfitting() {
    if (gameState.startingBudget - gameState.totalSpent < 0) {
        showNotice("BUDGET EXCEEDED", "You have overspent your budget! Reduce supplies before starting.");
        return;
    }
    if (gameState.factsMastered.size < 10) {
